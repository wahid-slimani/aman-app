generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ORGANISER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DEACTIVATED
}

enum PublicationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum OperationalStatus {
  OPEN
  TEMPORARILY_CLOSED
  FULL
  NEEDS_VERIFICATION
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DatasetChangeAction {
  PUBLISH
  ARCHIVE
  ROLLBACK
  TRANSFER_OWNERSHIP
  VERIFY
  UPDATE_STATUS
}

enum AnalyticsEventType {
  AUTH_LOGIN_SUCCESS
  AUTH_REFRESH_SUCCESS
  REPORT_SUBMITTED
  AID_POINT_NEARBY_SEARCH
  AID_POINT_VERIFIED
  AID_POINT_PUBLICATION_SUBMITTED
  AID_POINT_PUBLISHED
  AID_POINT_ARCHIVED
  REPORT_REVIEWED
}

model User {
  id             String           @id @default(cuid())
  username       String           @unique
  usernameNorm   String           @unique
  passwordHash   String
  role           UserRole
  status         UserStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lastLoginAt    DateTime?
  refreshSession RefreshSession[]
  organiser      OrganiserProfile?
  audits         AuditLog[]
  reviewedReports AidPointReport[] @relation("ReportReviewer")
  verifications   AidPointVerification[]
  datasetVersions DatasetVersion[]
  analyticsEvents AnalyticsEvent[]
}

model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String
  familyId     String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OrganiserProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  displayName      String
  organisationName String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  aidPoints        AidPoint[]
}

model AidPoint {
  id                 String            @id @default(cuid())
  publicSlug         String            @unique
  organiserId        String
  publicationStatus  PublicationStatus @default(DRAFT)
  operationalStatus  OperationalStatus @default(NEEDS_VERIFICATION)
  latitude           Decimal           @db.Decimal(10, 7)
  longitude          Decimal           @db.Decimal(10, 7)
  location           Unsupported("geography(Point,4326)")
  googleMapsUrl      String?
  primaryPhone       String
  secondaryPhone     String?
  whatsappPhone      String?
  lastVerifiedAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  publishedAt        DateTime?
  archivedAt         DateTime?
  version            Int               @default(1)
  organiser          OrganiserProfile  @relation(fields: [organiserId], references: [id], onDelete: Restrict)
  translations       AidPointTranslation[]
  reports            AidPointReport[]
  verifications      AidPointVerification[]
  datasetChanges     DatasetChange[]
  analyticsEvents    AnalyticsEvent[]

  @@index([organiserId])
  @@index([publicationStatus, operationalStatus])
}

model AidPointTranslation {
  id          String   @id @default(cuid())
  aidPointId  String
  locale      String
  name        String
  description String?
  address     String
  wilaya      String
  commune     String
  aidPoint    AidPoint @relation(fields: [aidPointId], references: [id], onDelete: Cascade)

  @@unique([aidPointId, locale])
  @@index([locale])
}

model AidPointReport {
  id             String       @id @default(cuid())
  aidPointId     String
  reason         String
  details        String
  reporterName   String?
  reporterPhone  String?
  status         ReportStatus @default(OPEN)
  reviewedAt     DateTime?
  reviewedById   String?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  aidPoint       AidPoint     @relation(fields: [aidPointId], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([aidPointId, status])
  @@index([createdAt])
}

model AidPointVerification {
  id          String   @id @default(cuid())
  aidPointId  String
  actorUserId String
  note        String?
  createdAt   DateTime @default(now())
  aidPoint    AidPoint @relation(fields: [aidPointId], references: [id], onDelete: Cascade)
  actorUser   User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([aidPointId, createdAt])
  @@index([actorUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model OperationalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DatasetVersion {
  id          String          @id @default(cuid())
  version     Int             @unique
  createdById String?
  note        String?
  createdAt   DateTime        @default(now())
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  changes     DatasetChange[]

  @@index([createdAt])
}

model DatasetChange {
  id               String              @id @default(cuid())
  datasetVersionId String
  aidPointId       String
  action           DatasetChangeAction
  publicationStatus PublicationStatus
  operationalStatus OperationalStatus
  snapshot         Json
  createdAt        DateTime            @default(now())
  datasetVersion   DatasetVersion      @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  aidPoint         AidPoint            @relation(fields: [aidPointId], references: [id], onDelete: Cascade)

  @@index([datasetVersionId])
  @@index([aidPointId, createdAt])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  type       AnalyticsEventType
  source     String
  locale     String?
  userRole   UserRole?
  userId     String?
  aidPointId String?
  wilaya     String?
  eventDate  DateTime
  payload    Json?
  createdAt  DateTime           @default(now())
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  aidPoint   AidPoint?          @relation(fields: [aidPointId], references: [id], onDelete: SetNull)

  @@index([type, eventDate])
  @@index([source, eventDate])
  @@index([userRole, eventDate])
  @@index([wilaya, eventDate])
}

model AnalyticsAggregate {
  id          String   @id @default(cuid())
  metricKey   String
  bucketDate  DateTime
  period      String
  dimension   String
  value       Int
  updatedAt   DateTime @updatedAt

  @@unique([metricKey, bucketDate, period, dimension])
  @@index([period, bucketDate])
  @@index([metricKey, period, bucketDate])
}
